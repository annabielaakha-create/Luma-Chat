{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile and preferences stored in Firestore",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 1024 },
        "defaultModel": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["userId", "email"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "User chat conversation session",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 256 },
        "model": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "title", "model"]
    },
    "Message": {
      "title": "Message",
      "description": "Message within a conversation",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "conversationId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["user", "assistant", "system"] },
        "content": { "type": "string", "maxLength": 100000 },
        "model": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "conversationId", "userId", "role", "content"]
    },
    "DocumentItem": {
      "title": "Document",
      "description": "Uploaded or processed document workspace item",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 256 },
        "size": { "type": "number" },
        "type": { "type": "string", "maxLength": 64 },
        "content": { "type": "string", "maxLength": 100000 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "name", "type"]
    },
    "ImageItem": {
      "title": "Image Record",
      "description": "Image saved or generated in workspace",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 256 },
        "dataUrl": { "type": "string", "maxLength": 2000000 },
        "prompt": { "type": "string", "maxLength": 2048 },
        "model": { "type": "string", "maxLength": 128 },
        "isGenerated": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "name", "dataUrl"]
    },
    "LibraryItem": {
      "title": "Library Item",
      "description": "Saved favorite response, prompt, or content snippet",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 256 },
        "itemType": { "type": "string", "enum": ["response", "document", "image", "prompt"] },
        "content": { "type": "string", "maxLength": 100000 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "title", "itemType", "content"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile documents"
    },
    "/conversations/{conversationId}": {
      "schema": { "$ref": "#/entities/Conversation" },
      "description": "User conversations"
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/Message" },
      "description": "Messages belonging to a conversation"
    },
    "/documents/{documentId}": {
      "schema": { "$ref": "#/entities/DocumentItem" },
      "description": "User uploaded documents"
    },
    "/images/{imageId}": {
      "schema": { "$ref": "#/entities/ImageItem" },
      "description": "User images and generations"
    },
    "/library/{libraryId}": {
      "schema": { "$ref": "#/entities/LibraryItem" },
      "description": "User saved library items"
    }
  }
}
